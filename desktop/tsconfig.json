{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "baseUrl": "..",
    "types": ["vite/client", "node"],
    "paths": { "@/*": ["client/src/*"], "@shared/*": ["shared/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
